# Data Migration Script - Example Environment Variables
# Copy this file to .env and fill in your credentials

# OLD DATABASE (Your current/development database)
OLD_SUPABASE_URL=https://your-old-project.supabase.co
OLD_SUPABASE_KEY=your_old_service_role_key_here

# NEW DATABASE (Client's production database)
NEW_SUPABASE_URL=https://client-project.supabase.co
NEW_SUPABASE_KEY=client_service_role_key_here

# Note: Use SERVICE ROLE KEY (not anon key) for full access during migration

